# Messages shown when the player's action is refused.

error-out-of-bounds = You can't build outside the city limits.
error-road-unknown-node = This road endpoint no longer exists.
error-road-unknown-segment = This road no longer exists.
error-road-self-loop = A road can't start and end at the same point.
error-road-duplicate = These two points are already connected.
error-road-no-lanes = A road needs at least one lane.
error-road-zero-speed = A road needs a speed limit above zero.
error-road-too-short = This road is too short.
error-command-rejected = Action refused: { $reason }
